# Loki S3 storage
LOKI_S3_ENDPOINT=s3.firstvds.ru
LOKI_S3_REGION=default
LOKI_S3_BUCKET=replace-with-loki-bucket
LOKI_S3_ACCESS_KEY_ID=replace-with-access-key
LOKI_S3_SECRET_ACCESS_KEY=replace-with-secret-key
LOKI_S3_FORCE_PATH_STYLE=true
LOKI_S3_INSECURE=false

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

# Grafana SMTP
GRAFANA_SMTP_ENABLED=true
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=alerts@example.com
GRAFANA_SMTP_PASSWORD=replace-with-smtp-password
GRAFANA_SMTP_FROM_ADDRESS=alerts@vedamatch.ru
GRAFANA_ALERT_EMAIL_TO=ops@vedamatch.ru

# Grafana Telegram
GRAFANA_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
GRAFANA_TELEGRAM_CHAT_ID=replace-with-chat-id
