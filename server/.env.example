# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=raguser
DB_PASSWORD=ragpassword
DB_NAME=ragdb

# JWT Secret (generate a random string)
JWT_SECRET=your-secret-key-change-this-in-production-min-32-chars
AUTH_REFRESH_V1=on
CHAT_HISTORY_V2=on
RAG_LITE_MARKET=on
PUSH_P2P=on
FF_REDIS_RATE_LIMIT=off
FF_HTTP_CONDITIONAL_CACHE=off
FF_CONTACTS_LEGACY_MODE=on
ROOM_SFU_ENABLED=off
ROOM_SFU_PROVIDER=livekit
ROOM_SFU_REQUIRE_MEMBERSHIP=on
ROOM_SFU_MAX_PARTICIPANTS=50
ROOM_SFU_MAX_SUBSCRIPTIONS=9
ROOM_SFU_VIDEO_PRESET=balanced
ROOM_SFU_DYNACAST_ENABLED=on
ROOM_SFU_ADAPTIVE_STREAM_ENABLED=on
ROOM_SFU_SIMULCAST_ENABLED=on
ROOM_SFU_TOKEN_TTL_MINUTES=15
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
ROOMS_SUPPORT_ENABLED=on
ROOMS_SUPPORT_PROJECT_ID=1
ROOMS_SUPPORT_DEFAULT_AMOUNT=20
ROOMS_SUPPORT_PROMPT_COOLDOWN_HOURS=24
ROOMS_SUPPORT_PLATFORM_CONTRIBUTION_ENABLED=on
ROOMS_SUPPORT_PLATFORM_CONTRIBUTION_DEFAULT=5
SEVA_SUPPORT_ENABLED=on
SEVA_SUPPORT_PROJECT_ID=2
SEVA_SUPPORT_DEFAULT_AMOUNT=20
SEVA_SUPPORT_PROMPT_COOLDOWN_HOURS=24
SEVA_SUPPORT_PLATFORM_CONTRIBUTION_ENABLED=on
SEVA_SUPPORT_PLATFORM_CONTRIBUTION_DEFAULT=5

# Server Configuration
PORT=8081

# S3/CDN Configuration (required for Video Circles in production)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=
S3_PUBLIC_URL=
CDN_ENABLED=true
CDN_BASE_URL=

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Push notifications (FCM/APNs gateway)
FCM_SERVER_KEY=
FCM_SENDER_MODE=auto
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: required by some Vertex/Antigravity-compatible gateways.
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
OPENAI_PROJECT_ID=your_openai_project_id

# Google Auth
AUTH_GOOGLE_ENABLED=off
AUTH_GOOGLE_ALLOWED_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID_DEBUG=
GOOGLE_ANDROID_CLIENT_ID_RELEASE=

# VK Auth (stage-2 rollout)
AUTH_VK_ENABLED=off
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://api.vedamatch.ru/auth/vk/callback
TELEGRAM_AUTH_ENABLED=on
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=300
TELEGRAM_AUTH_CIS_LANG_CODES=ru,uk,be,kk
