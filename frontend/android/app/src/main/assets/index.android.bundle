44'},selectButton:{margin:25,marginTop:0,height:55,borderRadius:15,justifyContent:'center',alignItems:'center'},selectButtonText:{color:'#FFF',fontSize:18,fontWeight:'bold'},backButton:{alignItems:'center',marginTop:10},backButtonText:{color:'#666',fontSize:16,textDecorationLine:'underline'}});_e.default=function(e){var c=e.navigation,s=((0,_r(d[6]).useTranslation)().t,(0,o.useState)('RU')),u=(0,t.default)(s,2),f=u[0],h=u[1],p=[{id:'trial',name:'Trial Plan',price:'RU'===f?"100 \u20bd":'$2',period:'month',features:['Full Access (Mocked)','AI Chat Support','Basic Matching'],color:['#FFCC00','#FF9933']},{id:'pro',name:'Pro Plan',price:'RU'===f?"500 \u20bd":'$6',period:'month',features:['Priority Matching','Unlimited AI Queries','Verified Profile Badge','Advance Search Filters'],color:['#FF9933','#CC6600']}];return(0,i.jsxs)(n.SafeAreaView,{style:l.container,children:[(0,i.jsx)(r.default,{colors:['#FFF9F0','#FFEEDD'],style:n.StyleSheet.absoluteFill}),(0,i.jsxs)(n.ScrollView,{contentContainerStyle:l.scrollContent,children:[(0,i.jsx)(n.Text,{style:l.title,children:"Choose Your Path"}),(0,i.jsx)(n.Text,{style:l.subtitle,children:"Select a plan to unlock full potential"}),(0,i.jsxs)(n.View,{style:l.regionSelector,children:[(0,i.jsx)(n.TouchableOpacity,{style:[l.regionButton,'RU'===f&&l.activeRegion],onPress:function(){return h('RU')},children:(0,i.jsx)(n.Text,{style:[l.regionText,'RU'===f&&l.activeRegionText],children:"Russia"})}),(0,i.jsx)(n.TouchableOpacity,{style:[l.regionButton,'Global'===f&&l.activeRegion],onPress:function(){return h('Global')},children:(0,i.jsx)(n.Text,{style:[l.regionText,'Global'===f&&l.activeRegionText],children:"Global"})})]}),p.map(function(e){return(0,i.jsxs)(n.View,{style:l.planCard,children:[(0,i.jsxs)(r.default,{colors:e.color,start:{x:0,y:0},end:{x:1,y:1},style:l.planHeader,children:[(0,i.jsx)(n.Text,{style:l.planName,children:e.name}),(0,i.jsxs)(n.View,{style:l.priceRow,children:[(0,i.jsx)(n.Text,{style:l.planPrice,children:e.price}),(0,i.j