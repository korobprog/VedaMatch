# S3 Storage Configuration (FirstVDS / Yandex Object Storage)
# IMPORTANT: Set S3_PUBLIC_URL ONLY ONCE. Do not duplicate this variable.
# For FirstVDS (path-style URLs):
S3_ENDPOINT=https://s3.firstvds.ru
S3_REGION=default
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET_NAME=your_bucket_id_here
S3_PUBLIC_URL=https://s3.firstvds.ru/your_bucket_id_here
#
# For Yandex Object Storage (virtual-hosted style):
# S3_ENDPOINT=storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_ACCESS_KEY=your_access_key_here
# S3_SECRET_KEY=your_secret_key_here
# S3_BUCKET_NAME=vedamatch-media
# S3_PUBLIC_URL=https://cdn.vedamatch.ru

# CDN
# Video circles use fail-fast upload in production (no local /uploads fallback).
CDN_ENABLED=true
CDN_BASE_URL=https://cdn.vedamatch.ru

# Feed worker
FEED_WORKER_ENABLED=true
FEED_REBUILD_INTERVAL_SEC=300
FEED_REBUILD_LIMIT=120
FEED_REBUILD_BATCH_SIZE=200

# Media worker
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_INTERVAL_SEC=60
MEDIA_WORKER_MAX_RETRIES=2
